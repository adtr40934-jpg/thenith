# Main Site & Panel Frontend Environment Example
VITE_BACKEND_URL=http://localhost:4000
VITE_API_BASE_URL=/api
PORT=3000
VITE_API_TIMEOUT=15000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_LANDING_CARD_IMAGES=

# =========================================================
# Microsoft Clarity Analytics (تسجيل الجلسات والخرائط الحرارية)
# =========================================================
# معرّف المشروع الخاص بـ Microsoft Clarity (Project ID)
# احصل عليه من https://clarity.microsoft.com -> Settings -> Overview -> Project ID
VITE_CLARITY_PROJECT_ID=

# تفعيل أو إيقاف الأداة بالكامل (true للتشغيل | false للإيقاف)
VITE_CLARITY_ENABLED=true

# تشغيل التتبع أثناء التطوير المحلي localhost (true للتجربة محلياً | false لمنع تلويث إحصائيات الإنتاج)
VITE_CLARITY_ENABLE_IN_DEV=false

# إدارة الموافقة وملفات تعريف الارتباط Cookies (true للموافقة التلقائية | false للرفض)
VITE_CLARITY_CONSENT=true
